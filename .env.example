# Verhub 部署配置模板（docker compose）。
#
# 复制成 .env 后按需修改。本文件列出 docker-compose.yml / docker-compose.dev.yml
# 会读取的全部变量：注释掉的项都有内置默认值，不设也能跑；未注释的项必须填。
# 后端各项的取值含义见 doc/guide/deployment.md。

# ── 镜像 ──────────────────────────────────────────────────────────────

# 镜像版本（latest 或 v1.2.3）
VERHUB_TAG=latest

# 如果要切换到 GHCR，可改成：ghcr.io/ivanhanloth/verhub-backend / verhub-frontend
VERHUB_BACKEND_IMAGE=docker.io/ivanhanloth/verhub-backend
VERHUB_FRONTEND_IMAGE=docker.io/ivanhanloth/verhub-frontend

# ── 数据库 ────────────────────────────────────────────────────────────

VERHUB_POSTGRES_DB=verhub
VERHUB_POSTGRES_USER=verhub
VERHUB_POSTGRES_PASSWORD=change-this-strong-db-password

# 仅 docker-compose.dev.yml 使用：把数据库端口映射到宿主机，供 psql / Prisma Studio 连接。
# 生产编排不暴露该端口。
#VERHUB_POSTGRES_PORT=5432

# ── 必填安全项 ────────────────────────────────────────────────────────

JWT_SECRET=change-this-very-strong-jwt-secret
API_KEY_SALT=change-this-unique-api-key-salt

# ── 后端可选项 ────────────────────────────────────────────────────────

# 管理端 JWT 有效期，默认 2h
JWT_EXPIRES_IN=2h

# 首次启动时用于初始化管理员口令；留空则由容器生成并写入 bootstrap 卷
ADMIN_PASSWORD=

# 客户端 IP 识别：可信反代层数。套 CDN 时改成 2（CDN + 自带 nginx 各一层），默认 1
#VERHUB_TRUSTED_PROXY_COUNT=1

# 指定携带真实客户端 IP 的请求头（如 CF-Connecting-IP）；留空按可信层数解析 X-Forwarded-For
#VERHUB_CLIENT_IP_HEADER=

# 来源地区解析。关闭后不再向任何第三方发送 IP，统计里也不再有地区维度，默认 true
#VERHUB_GEO_ENABLED=true

# 启用的归属地查询提供方，逗号分隔，按顺序回退；留空即使用内置全部六家。
# 可选值：pconline.com.cn、cz88.net、ipwho.is、freeipapi.com、ipapi.co、ip-api.com
# 只想把 IP 发往境内服务时，填 pconline.com.cn,cz88.net
#VERHUB_GEO_PROVIDERS=

# 归属地解析结果的缓存有效期（天），默认 30
#VERHUB_GEO_TTL_DAYS=30

# 单次归属地查询超时（毫秒），默认 2500
#VERHUB_GEO_TIMEOUT_MS=2500

# 重复上报的抑制窗口（秒）：窗口内内容相同的反馈/日志/行为记录折叠为一条，默认 60；
# 设 0 关闭去重
#VERHUB_DEDUP_WINDOW_SECONDS=60

# 公开上报接口（日志/反馈/行为/检查更新）单 IP 每分钟限流次数，默认 300。
# 按可信反代解析出的真实客户端 IP 计数；调大可放宽，过大则失去防洪泛意义。
#VERHUB_PUBLIC_RATE_LIMIT=300

# 反馈转发到 GitHub Issue 的额外限流：单 IP 在 TTL 秒内最多转发多少条。
# 默认 3 条 / 3600 秒；这条比上面那道严得多，因为每次转发都会往仓库里建一条 Issue。
#VERHUB_GITHUB_FORWARD_RATE_LIMIT=3
#VERHUB_GITHUB_FORWARD_RATE_TTL=3600

# ── 前端 ──────────────────────────────────────────────────────────────

# 后端接口前缀。构建期变量：改它需要重新构建前端镜像，改 .env 对预构建镜像无效
NEXT_PUBLIC_API_BASE_URL=/api/v1

# 站点对外地址（如 https://verhub.example.com），用于 canonical、Open Graph 与
# 服务端取数；留空回落到 https://verhub.app
#NEXT_PUBLIC_SITE_URL=

# 关于页「文档」按钮的兜底地址，仅在上游未给出时使用
#NEXT_PUBLIC_ABOUT_DOCS_URL=

# 关于页更新检查的上游源；留空即固定走官方 https://verhub.hanloth.cn。
# 仅在需要指向自有 Verhub 实例时才覆盖（填站点 origin，接口前缀固定 /api/v1）
VERHUB_ABOUT_UPSTREAM_URL=

# ── 暴露端口 ──────────────────────────────────────────────────────────

VERHUB_HTTP_PORT=80
VERHUB_HTTPS_PORT=443
