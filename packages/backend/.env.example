# 后端本地开发配置模板。复制成 .env 后按需修改。
#
# 容器化部署走仓库根目录的 .env（见 .env.example），本文件只服务于
# `pnpm --filter @workspace/backend dev` 这种直接跑在宿主机上的场景。
# 注释掉的项都有内置默认值，不设也能跑；各项含义见 doc/guide/deployment.md。

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/verhub?schema=public"

# ── 必填安全项 ────────────────────────────────────────────────────────

JWT_SECRET="replace-with-a-strong-secret"
API_KEY_SALT=""

# ── 管理员引导 ────────────────────────────────────────────────────────

JWT_EXPIRES_IN="2h"
# 首次启动时用于初始化管理员口令；留空则生成随机口令并写入 BOOTSTRAP_SECRET_DIR
ADMIN_PASSWORD=""
# 随机口令的落盘目录；留空则只打印在启动日志里
BOOTSTRAP_SECRET_DIR=""

# ── 客户端 IP 识别 ────────────────────────────────────────────────────

# 可信反代层数，默认 1。本机直连调试可设 0
#VERHUB_TRUSTED_PROXY_COUNT=1
# 指定携带真实客户端 IP 的请求头；留空按可信层数解析 X-Forwarded-For
#VERHUB_CLIENT_IP_HEADER=

# ── 来源地区解析 ──────────────────────────────────────────────────────

# 关闭后不再向任何第三方发送 IP，统计里也不再有地区维度，默认 true。
# 本地开发建议关掉：省去每次上报都往外发一次查询
#VERHUB_GEO_ENABLED=true
# 启用的提供方，逗号分隔，按顺序回退；留空即内置全部六家。
# 可选值：pconline.com.cn、cz88.net、ipwho.is、freeipapi.com、ipapi.co、ip-api.com
#VERHUB_GEO_PROVIDERS=
# 解析结果缓存有效期（天），默认 30
#VERHUB_GEO_TTL_DAYS=30
# 单次查询超时（毫秒），默认 2500
#VERHUB_GEO_TIMEOUT_MS=2500

# ── 上报去重与限流 ────────────────────────────────────────────────────

# 重复上报的抑制窗口（秒），默认 60；设 0 关闭去重。
# 反复调同一个接口造数据时会撞上它，本地开发可设 0
#VERHUB_DEDUP_WINDOW_SECONDS=60

# 公开上报接口单 IP 每分钟限流次数，默认 300
#VERHUB_PUBLIC_RATE_LIMIT=300

# 反馈转发到 GitHub Issue 的额外限流：单 IP 在 TTL 秒内最多转发多少条，
# 默认 3 条 / 3600 秒
#VERHUB_GITHUB_FORWARD_RATE_LIMIT=3
#VERHUB_GITHUB_FORWARD_RATE_TTL=3600
