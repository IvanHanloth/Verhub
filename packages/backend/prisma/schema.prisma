generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GUEST
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// 平台维度，发布目标（版本/公告）与来源统计共用一套取值。
///
/// 只有这七个粗粒度分类，具体系统版本走独立的 `platformVersion` 自由文本
/// （"11" / "ubuntu 24.04" / "26"），不再往枚举里堆 Windows 11、Ubuntu 这类值：
/// 枚举一旦细化就必须随发行版更新，而统计需要的恰恰是稳定的分组维度。
///
/// `WEB` 只在客户端显式声明时产生——浏览器 UA 本身带真实 OS，UA 推断永远给出
/// 具体系统而非 WEB；它保留下来是因为版本/公告的「Web 版」是有意义的发布目标。
/// `OTHERS` 是兜底：识别不出、未声明、或该平台不在上述分类中。
enum Platform {
  WINDOWS
  LINUX
  MACOS
  IOS
  ANDROID
  WEB
  OTHERS
}

/// Public endpoints tracked by request statistics. One member per public route;
/// adding a public route means adding a member here and mapping it in the
/// statistics interceptor.
enum PublicEndpoint {
  PROJECT_DETAIL
  VERSION_LIST
  VERSION_LATEST
  VERSION_LATEST_PREVIEW
  VERSION_BY_VERSION
  VERSION_CHECK_UPDATE
  ANNOUNCEMENT_LIST
  ANNOUNCEMENT_LATEST
  FEEDBACK_SUBMIT
  LOG_UPLOAD
  EVENT_INGEST
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt    Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  apiKeys      ApiKey[]
}

model ApiKey {
  id                   String   @id @default(cuid())
  name                 String
  keyHash              String   @unique
  previousKeyHash      String?
  previousKeyExpiresAt Int?
  scopes               String[] @default([])
  allProjects          Boolean  @default(true)
  projectIds           String[] @default([])
  isActive             Boolean  @default(true)
  lastUsedAt           Int?
  expiresAt            Int?
  createdAt            Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  revokedAt            Int?
  createdById          String?

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([isActive, expiresAt])
}

model Project {
  projectKey                         String                    @id
  name                               String
  repoUrl                            String?
  description                        String?
  author                             String?
  authorHomepageUrl                  String?
  iconUrl                            String?
  websiteUrl                         String?
  docsUrl                            String?
  publishedAt                        Int?
  optionalUpdateMinComparableVersion String?
  optionalUpdateMaxComparableVersion String?
  /// Shared secret for this project's GitHub release webhook. Stored in
  /// plaintext because HMAC-SHA256 verification needs the original value —
  /// a hash cannot reproduce the signature GitHub sends. Null disables the
  /// webhook endpoint: unsigned deliveries are never accepted.
  githubWebhookSecret                String?
  /// When the webhook secret was last set or regenerated, in Unix seconds.
  githubWebhookSecretUpdatedAt       Int?
  /// How long hourly request statistics are kept, in days. Capped at 365.
  statsRetentionDays                 Int                       @default(365)
  /// 事件采集总开关。关掉后采集端点空转返回 202，既有数据保留。
  /// 给运营者一个立即止血的手段：收到监管问询时不必改配置重启。
  eventCollectionEnabled             Boolean                   @default(true)
  /// 事件明细的保留期，独立于 statsRetentionDays 且默认更短。
  /// 明细带 distinctId，是可关联到个人的高频数据，不该与纯计数用同一窗口。
  eventRetentionDays                 Int                       @default(90)
  createdAt                          Int                       @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt                          Int                       @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  versions                           Version[]
  announcements                      Announcement[]
  feedbacks                          Feedback[]
  logs                               Log[]
  eventDefinitions                   EventDefinition[]
  eventRecords                       EventRecord[]
  eventStats                         EventStat[]
  eventActiveUsers                   EventActiveUser[]
  eventDashboardCards                EventDashboardCard[]
  requestStats                       ApiRequestStat[]
  clientVersionStats                 ClientVersionStat[]
  platformVersionStats               PlatformVersionStat[]
  aliases                            ProjectAlias[]
  locales                            ProjectLocale[]
  translations                       ProjectTranslation[]
  githubIntegration                  ProjectGithubIntegration?
}

/// 实例级 GitHub App 配置，单行表（id 恒为 "default"）。
///
/// GitHub App 不是必选项：整行为空/未启用任何功能时，项目级的相关开关一律拒绝打开。
/// 私钥用 AES-256-GCM 加密存储（密钥派生自 JWT_SECRET），任何接口都不回读原文，
/// 只暴露 SHA-256 指纹供 UI 区分换没换过钥匙。
model GithubAppConfig {
  id                          String   @id @default("default")
  /// GitHub App 的数字 App ID。
  appId                       String?
  /// App 私钥（PEM）加密后的密文，格式 v1:<iv>:<tag>:<data>。
  privateKeyEncrypted         String?
  privateKeyFingerprint       String?
  privateKeyUpdatedAt         Int?
  /// App 级 webhook secret（App 事件如 issue_comment 投递到实例级端点验签用）。
  /// 与项目级 release webhook secret 是两套体系。明文存储原因同 Project 上的注释。
  webhookSecret               String?
  webhookSecretUpdatedAt      Int?
  /// 实例级启用的功能开关，取值见 GITHUB_APP_FEATURES（feedback_issue / comment_commands）。
  /// 未在这里启用的功能，项目级开关不允许打开。
  enabledFeatures             String[] @default([])
  /// 关掉时下面两列一律被忽略，实例缺省即内置模板；打开才让自定义值生效。
  /// 有这个开关，管理员改坏模板后不必逐字删回内置文案。
  feedbackIssueCustomTemplate Boolean  @default(false)
  /// 反馈转发 Issue 的实例级缺省模板；项目级模板优先。
  feedbackIssueTitleTemplate  String?
  feedbackIssueBodyTemplate   String?
  updatedAt                   Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
}

/// 实例级条款文档的自定义内容，一份文档一行，按需创建。
///
/// slug 取值见 TERMS_DOCUMENT_SLUGS（privacy-policy / sdk-compliance），
/// 内置正文在代码里，不入库：行不存在即表示该文档沿用内置正文，前台永远有条款可读。
model TermsDocument {
  slug             String  @id
  /// 关掉时忽略下面的自定义正文，前台展示内置正文；打开才让自定义正文生效。
  /// 有这个开关，运营者改坏正文后不必逐字删回内置文案。
  custom           Boolean @default(false)
  /// 自定义正文（Markdown）。null 表示从未编辑过。
  content          String?
  /// 自定义正文最近一次保存的时间，供前台显示「最后更新」。
  /// 与 updatedAt 分开：改开关不该让访问者以为条款内容变了。
  contentUpdatedAt Int?
  updatedAt        Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
}

/// 实例级 AI 翻译配置（单例）。后台译文编辑处的「AI 翻译」按钮用它调上游模型。
///
/// 上游凭据必须由部署方自己填：Verhub 是自部署产品，不内置任何厂商的地址与 key。
/// 译文永远只回给后台当草稿，不经这里入库——机器译文得有人过一眼才算数。
model TranslationConfig {
  id                String  @id @default("default")
  /// 总闸。关掉时翻译端点一律拒绝，后台也不显示翻译按钮，凭据留着不动。
  enabled           Boolean @default(false)
  /// 上游协议，取值见 TRANSLATION_PROVIDERS：
  /// openai（POST {baseUrl}/chat/completions）或 anthropic（POST {baseUrl}/v1/messages）。
  provider          String  @default("openai")
  /// 路径前缀，如 https://api.openai.com/v1。后缀按 provider 固定拼接，
  /// 不替管理员猜写法（同 ProjectLocale 不做 BCP 47 规范化的理由）。
  baseUrl           String?
  /// API key 加密后的密文，格式 v1:<iv>:<tag>:<data>，见 secret-box。
  /// 自建 Ollama / vLLM 常常无鉴权，留空即请求不带鉴权头，不算配置不全。
  apiKeyEncrypted   String?
  apiKeyFingerprint String?
  apiKeyUpdatedAt   Int?
  model             String?
  /// 关掉时忽略下面的 systemPrompt，一律用内置提示词；打开才让自定义值生效。
  /// 有这个开关，管理员把提示词改坏后不必逐字删回内置文案。
  customPrompt      Boolean @default(false)
  systemPrompt      String?
  updatedAt         Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
}

/// 项目级 GitHub 集成配置（GitHub App 相关功能，一项目一行，按需创建）。
model ProjectGithubIntegration {
  projectKey                    String   @id
  /// 目标仓库 "owner/repo"。反馈转发的 Issue 建在这里，comment 命令也按它路由。
  repoFullName                  String?
  /// 允许把反馈转发为 GitHub Issue。生效还需实例级启用 feedback_issue 且 App 凭据齐全。
  /// 只是「允许」：是否真的转发由提交者在客户端逐条选择，选了才要求填联系方式。
  feedbackIssueEnabled          Boolean  @default(false)
  /// 模板来源：inherit（跟随实例）/ custom（本项目自定义）/ repo（读目标仓库里的文件）。
  feedbackIssueTemplateSource   String   @default("inherit")
  /// source=repo 时模板文件在目标仓库中的路径与 ref（ref 留空取仓库默认分支）。
  /// 文件内容带缓存定期重取，仓库里改完模板不需要回来点保存。
  feedbackIssueTemplateRepoPath String?
  feedbackIssueTemplateRepoRef  String?
  feedbackIssueTitleTemplate    String?
  feedbackIssueBodyTemplate     String?
  feedbackIssueLabels           String[] @default([])
  /// GitHub comment 命令（/verhub-xxx 触发 workflow_dispatch）。
  commentCommandsEnabled        Boolean  @default(false)
  /// 允许触发命令的评论者与仓库的关联（GitHub author_association 取值）。
  commandAllowedAssociations    String[] @default(["OWNER", "MEMBER", "COLLABORATOR"])
  /// 关联之外额外放行的 GitHub 用户名；与上面的关联判断取并集。
  commandAllowedUsers           String[] @default([])
  /// 命令定义数组：[{ name, workflow, ref, input }]。
  /// /verhub-<name> <args> 会向 workflow 发 workflow_dispatch，args 作为 inputs[input] 传入。
  commands                      Json?
  updatedAt                     Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade, onUpdate: Cascade)

  @@index([repoFullName])
}

/// 项目改名（变更 projectKey）后保留下来的旧 key。旧 key 作为别名指回当前项目，
/// 公共与管理接口经 ProjectResolverService 解析后，用旧 key 仍能透明访问到项目内容。
///
/// `alias` 直接做主键：别名全局唯一，且不得与任何现存 projectKey 或其它别名重复
/// —— 这层跨表唯一性由应用层在建项目/改名时校验，单表约束无法表达。
/// onUpdate: Cascade —— 项目再次改名时，指向它的别名自动跟到新 projectKey，
/// 别名链始终扁平地指向当前项目，不会退化成需要多跳解析的链条。
model ProjectAlias {
  alias      String @id
  projectKey String
  createdAt  Int    @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectKey])
}

/// 项目注册的语言。公告与项目译文只认这张表里的语言：
/// 客户端提交未注册的语言偏好，等同没提，回落到默认内容。
///
/// 注销一个语言不会删掉已有译文——译文留着，只是暂时不可达，重新注册即恢复。
model ProjectLocale {
  projectKey String
  /// 语言标签，如 zh-CN / en-US。原样保存录入时的写法，匹配时大小写不敏感；
  /// 不做 BCP 47 规范化——语言由项目自己定，服务端不该替它猜标准写法。
  locale     String
  /// 同义标签：命中其中任何一个都等价于命中主标签（多对一）。
  /// 例如主标签 en 列出 en-US / en-GB，三种写法取到同一份译文。
  /// 只认显式列出的，不做 en-* 前缀自动回退——那样无法单独给某个地区变体做
  /// 不同处理，出问题时也说不清为什么命中了这个语言。
  /// 应用层保证同一项目内不与其它语言的主标签或同义标签相撞。
  aliases    String[] @default([])
  /// 后台展示名，如「简体中文」。留空则界面上直接显示 locale。
  label      String?
  createdAt  Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade, onUpdate: Cascade)

  @@id([projectKey, locale])
  @@index([projectKey])
}

/// 项目的名称与描述译文。与公告译文同一套语义：默认值在 Project 自身，
/// 这里只是覆盖层，字段留空即回落默认值。
model ProjectTranslation {
  projectKey  String
  /// 必须是本项目注册过的语言（见 ProjectLocale）。
  locale      String
  /// 留空即用项目自身的 name。
  name        String?
  /// 留空即用项目自身的 description。
  description String?
  createdAt   Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt   Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade, onUpdate: Cascade)

  @@id([projectKey, locale])
  @@index([projectKey])
}

/// Hourly rollup of public API requests, one row per
/// (project, endpoint, hour, platform, region, regionCode, cityCode) combination.
///
/// `region` holds the ISO-3166 alpha-2 country code resolved from the caller's
/// IP, or one of the sentinels `UNKNOWN` (no IP, or every lookup provider
/// failed) / `LOCAL` (private or loopback address, never sent to a provider).
/// Dimension columns are NOT NULL with an explicit sentinel: Postgres treats
/// NULLs as distinct in unique indexes, which would silently break the
/// upsert-increment.
model ApiRequestStat {
  id         String         @id @default(cuid())
  projectKey String
  endpoint   PublicEndpoint
  /// Unix seconds truncated to the start of the hour (UTC).
  hourBucket Int
  platform   Platform       @default(OTHERS)
  region     String         @default("UNKNOWN")
  /// 省/市级行政区划码（GB/T 2260），仅 region=CN 时非空；境外/未定位为空串。
  /// 空串而非 NULL：Postgres unique 视 NULL 互异，会破坏 upsert-increment（同 region/platform 的理由）。
  regionCode String         @default("")
  cityCode   String         @default("")
  count      Int            @default(0)
  createdAt  Int            @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt  Int            @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, endpoint, hourBucket, platform, region, regionCode, cityCode])
  @@index([projectKey, hourBucket])
  @@index([hourBucket])
}

/// Hourly rollup of the version each client reports when it calls check-update,
/// one row per (project, version, hour, platform).
///
/// This is what "which version is actually in the field" is answered from:
/// `Version` only says what has been published, never what is installed. The
/// value is the client's own `current_version` string, stored verbatim rather
/// than normalized — a version the server has never published is exactly the
/// signal an operator wants to see, so coercing it into a known release would
/// destroy the finding. Shares the retention sweep with `ApiRequestStat`.
model ClientVersionStat {
  id         String   @id @default(cuid())
  projectKey String
  /// Client-reported version string, trimmed. Never null; unreported calls are not recorded.
  version    String
  /// Unix seconds truncated to the start of the hour (UTC).
  hourBucket Int
  platform   Platform @default(OTHERS)
  count      Int      @default(0)
  createdAt  Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt  Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, version, hourBucket, platform])
  @@index([projectKey, hourBucket])
  @@index([hourBucket])
}

/// 客户端系统版本的小时汇总，一行一个 (project, hour, platform, platformVersion)。
///
/// 单独一张表而不是给 ApiRequestStat 加一列：那张表已经是
/// endpoint×region×省×市 的笛卡尔积，再乘一个自由文本维度会成倍放大行数，
/// 而「系统版本分布」根本不需要按端点或地区下钻。
///
/// `platformVersion` 是归一化后的自由文本（小写、去掉与 platform 重复的前缀），
/// 空串表示客户端没报——空串而非 NULL 的理由同 ApiRequestStat.regionCode。
/// 与 ApiRequestStat 共用保留期清理。
model PlatformVersionStat {
  id              String   @id @default(cuid())
  projectKey      String
  /// Unix seconds truncated to the start of the hour (UTC).
  hourBucket      Int
  platform        Platform @default(OTHERS)
  platformVersion String   @default("")
  count           Int      @default(0)
  createdAt       Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt       Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, hourBucket, platform, platformVersion])
  @@index([projectKey, hourBucket])
  @@index([hourBucket])
}

/// Persistent IP → origin cache, shared by every collection point.
///
/// The public geo APIs are rate limited (tens of calls per minute) and are the
/// slowest thing in a request path that is otherwise pure database work, so a
/// lookup must happen once per address rather than once per request. Persisted
/// rather than in-memory only because a restart would otherwise replay the
/// whole working set against the provider and trip its limiter.
///
/// Failures are cached too, as `source = "NONE"` with a short `expiresAt`: an
/// address no provider can place must not be retried on every single request.
model IpGeoCache {
  /// Normalized address (IPv4-mapped IPv6 unwrapped), the natural key.
  ip          String  @id
  /// ISO-3166 alpha-2, or `UNKNOWN` / `LOCAL`. Mirrors ApiRequestStat.region.
  countryCode String  @default("UNKNOWN")
  countryName String?
  regionName  String?
  city        String?
  /// 省/市级行政区划码（GB/T 2260），仅国内 provider 命中时非空。聚合按码分组以规避各家中文名不一致。
  regionCode  String?
  cityCode    String?
  /// Provider that answered, or "NONE" for a negative entry.
  source      String
  resolvedAt  Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  /// Unix seconds after which the entry must be resolved again.
  expiresAt   Int

  @@index([expiresAt])
}

/// 事件定义，由采集端自动发现而非管理员预先登记。
///
/// 上报不依赖本表存在：客户端直接报事件名，服务端第一次见到就建行。这是与旧
/// Action 模型最关键的差别——旧模型要求先在后台建一条记录、把生成的 cuid 硬编码
/// 进客户端代码，这道门槛让该功能从未被任何接入方使用过。管理员在这里做的只是
/// 事后补充显示名与描述、或把停用的事件归档。
model EventDefinition {
  id          String  @id @default(cuid())
  projectKey  String
  /// 归一化后的事件名（小写、去空白，上限 64），项目内唯一。
  name        String
  /// 给管理端看的中文名；为空时界面回退到 name。
  displayName String?
  description String?
  /// 归档后不出现在事件选择器里，历史数据不受影响。
  archived    Boolean @default(false)
  firstSeenAt Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  lastSeenAt  Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  createdAt   Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt   Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, name])
  @@index([projectKey, archived, lastSeenAt])
}

/// 事件明细，漏斗 / 留存 / 路径分析的唯一数据源。
///
/// 小时汇总表（EventStat）丢掉了 distinctId 维度，任何需要「同一个人是否依次做了
/// A 再做 B」的问题都只能回明细算，所以这张表不能像 ApiRequestStat 那样只留计数。
///
/// 与 Log / Feedback 的两处有意差异：
/// - 没有 http 列。旧 ActionRecord 把整个请求头塞进 JSON，既是存储放大也是隐私
///   负担，而 properties 已经覆盖了接入方真正需要的结构化内容。
/// - ip 默认只存匿名化后的值（见 VERHUB_EVENT_IP_STORAGE）。事件量比日志大一个
///   数量级，且用途是聚合分析而非逐条排障，留完整地址不成比例。
/// - 没有 dedupHash。eventId 幂等键精确解决了重试补发的重复，而 60 秒内容指纹是
///   模糊的：它会把「用户连点三次」折叠成一次，那恰恰是行为分析要看的信号。
model EventRecord {
  id         String  @id @default(cuid())
  projectKey String
  eventName  String
  /// 客户端生成的匿名标识（随机 UUID，非设备指纹），用于串联同一使用者的事件序列。
  distinctId String
  /// 会话标识，默认 30 分钟无事件即换新；客户端未启用会话时为空。
  sessionId  String?
  /// 客户端上报的幂等键。离线队列重试补发时靠它去重，见 (projectKey, eventId) 唯一索引。
  eventId    String
  /// 客户端声明的发生时间。离线补发必须信任它，但服务端会做时钟偏移钳制。
  occurredAt Int
  /// 服务端接收时间，与 occurredAt 分开存以便发现时钟异常的客户端。
  receivedAt Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  /// 接入方自定义的扁平属性。带 GIN 索引，支持按属性筛选与分组统计。
  properties Json?

  /// Caller origin, captured at submit time. See the `Log` model for why these
  /// are columns rather than keys inside a JSON blob.
  ip              String?
  userAgent       String?
  countryCode     String?
  countryName     String?
  regionName      String?
  city            String?
  platform        Platform?
  platformVersion String?

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, eventId])
  @@index([projectKey, eventName, occurredAt])
  @@index([projectKey, distinctId, occurredAt])
  @@index([projectKey, sessionId, occurredAt])
  @@index([projectKey, occurredAt])
  /// 属性筛选与分组走 JSONB 包含查询。jsonb_path_ops 比默认算子类小得多，
  /// 代价是只支持 @>——而按属性等值筛选正是这里唯一需要的形状。
  @@index([properties(ops: JsonbPathOps)], type: Gin)
}

/// 事件量的小时汇总，一行一个
/// (project, eventName, hour, platform, region, regionCode, cityCode)。
///
/// 形状与哨兵值约定照搬 ApiRequestStat：维度列 NOT NULL 且用显式哨兵
/// （UNKNOWN / LOCAL / 空串），因为 Postgres 的 unique 索引视 NULL 互异，
/// 用 NULL 会静默破坏 upsert-increment。
///
/// 本表不含任何标识符，时间精度为自然小时，无法回溯到具体设备或还原访问序列，
/// 因而不随数据主体的删除请求一并删除。
model EventStat {
  id         String   @id @default(cuid())
  projectKey String
  eventName  String
  /// Unix seconds truncated to the start of the hour (UTC).
  hourBucket Int
  platform   Platform @default(OTHERS)
  region     String   @default("UNKNOWN")
  regionCode String   @default("")
  cityCode   String   @default("")
  count      Int      @default(0)
  createdAt  Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt  Int      @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, eventName, hourBucket, platform, region, regionCode, cityCode])
  @@index([projectKey, hourBucket])
  @@index([hourBucket])
}

/// 按自然日去重的活跃标识，供 DAU 与留存矩阵做人群交集。
///
/// 直接存去重行而不是 HyperLogLog：留存要算 day0 与 dayN 的人群**交集**，
/// 近似基数结构做不了这件事。自部署量级下行数完全可控。
model EventActiveUser {
  id         String @id @default(cuid())
  projectKey String
  /// Unix seconds truncated to the start of the day (UTC).
  dayBucket  Int
  distinctId String

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@unique([projectKey, dayBucket, distinctId])
  @@index([projectKey, dayBucket])
  @@index([projectKey, distinctId])
}

/// 看板卡片，保存一份指标 DSL 查询定义。
///
/// 只存定义不存结果：结果随时间范围变化，缓存下来反而会给出过期数字。
/// query 的结构与校验见 events/dsl/。
model EventDashboardCard {
  id          String  @id @default(cuid())
  projectKey  String
  title       String
  description String?
  /// 指标 DSL，执行时走受控编译路径，从不拼接 SQL。
  query       Json
  /// 前端网格布局（列宽、行高），纯展示用，后端不解析。
  layout      Json?
  sortOrder   Int     @default(0)
  createdAt   Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt   Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@index([projectKey, sortOrder])
}

model Version {
  id                    String     @id @default(cuid())
  projectKey            String
  version               String
  comparableVersion     String?
  /// comparableVersion 的定长排序键，由 toComparableVersionSortKey 生成。
  /// 存在的理由：comparableVersion 是 TEXT，字符串序把 "3.1.0-rc.2" 排在 "3.1.0" 之上，
  /// 与 semver 语义相反。这一列让数据库的字符串排序等价于语义排序。
  comparableVersionSort String?
  title                 String?
  content               String?
  downloadUrl           String?
  downloadLinks         Json?
  forced                Boolean    @default(false)
  isLatest              Boolean    @default(false)
  isPreview             Boolean    @default(false)
  isMilestone           Boolean    @default(false)
  isDeprecated          Boolean    @default(false)
  platforms             Platform[] @default([])
  platform              Platform?
  customData            Json?
  publishedAt           Int        @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  createdAt             Int        @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project      Project              @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)
  translations VersionTranslation[]

  @@unique([projectKey, version])
  @@index([projectKey, createdAt])
  // 版本列表与最新版判定按 comparableVersionSort 降序；无此索引时排序退化为内存排序。
  @@index([projectKey, comparableVersionSort])
  // comparableVersion 仍被按版本号精确查找用到（findByVersionNumber）。
  @@index([projectKey, comparableVersion])
}

/// 版本的标题与更新说明译文。语义同 AnnouncementTranslation：默认值在 Version 自身，
/// 这里只是覆盖层，字段留空即回落默认值。
///
/// 没有 isHidden：版本是分发对象，「对某个语言的用户藏掉某个版本」意味着那些用户
/// 收不到更新提示却仍能下到包，是个说不清的状态。要停发就用 isDeprecated，它对所有人生效。
model VersionTranslation {
  versionId String
  /// 必须是本项目注册过的语言（见 ProjectLocale）。
  locale    String
  /// 留空即用版本自身的 title。
  title     String?
  /// 留空即用版本自身的 content。
  content   String?
  createdAt Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@id([versionId, locale])
  @@index([versionId])
}

model Announcement {
  id                       String     @id @default(cuid())
  projectKey               String
  title                    String
  content                  String
  isPinned                 Boolean    @default(false)
  isHidden                 Boolean    @default(false)
  platforms                Platform[] @default([])
  author                   String?
  /// 可见版本范围（闭区间，两端可空，空即该端不限）。语义与 Project 上的
  /// optionalUpdateMin/MaxComparableVersion 一致：拿客户端上报的版本号去比。
  /// 客户端没报版本号时，带范围的公告一律不返回——判断不了就不展示。
  minComparableVersion     String?
  maxComparableVersion     String?
  /// 上面两个的定长排序键，由 toComparableVersionSortKey 生成，让范围过滤能在
  /// SQL 层用字符串 lte/gte 完成（否则得把公告全量拉进内存比较，分页也会错）。
  minComparableVersionSort String?
  maxComparableVersionSort String?
  publishedAt              Int        @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  createdAt                Int        @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt                Int        @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project      Project                   @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)
  translations AnnouncementTranslation[]

  @@index([projectKey, createdAt])
}

/// 公告译文，本质是「某个语言下的覆盖设置」，三个维度彼此独立：
/// title 空即用默认标题、content 空即用默认正文、isHidden 为真则该语言下整条不返回。
/// 因此「只想对英文用户藏起来、又不想写英文译文」是可表达的：只留 isHidden 即可。
model AnnouncementTranslation {
  announcementId String
  /// 语言标签，取值必须是项目注册过的（见 ProjectLocale）。
  /// 原样保存注册时的写法，匹配时大小写不敏感。
  locale         String
  title          String?
  content        String?
  /// 该语言下不返回这条公告。与公告自身的 isHidden 是两层：那个对所有人生效。
  isHidden       Boolean @default(false)
  createdAt      Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))
  updatedAt      Int     @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, locale])
  @@index([announcementId])
}

model Feedback {
  id                String    @id @default(cuid())
  projectKey        String
  userId            String?
  rating            Int?
  content           String
  /// 提交者留下的联系方式（邮箱 / 手机号 / IM 账号等），自由文本，可空。
  contact           String?
  /// 隐藏后不在后台列表默认返回（需显式 include_hidden），但记录仍在，
  /// 评分也照常计入统计 —— 隐藏只影响展示，不影响数据。
  isHidden          Boolean   @default(false)
  /// Declared by the client when it submits, else inferred from the User-Agent.
  platform          Platform?
  /// 系统版本明细（`platform_version` 字段、`x-verhub-platform-version` 头，或从
  /// UA 解析），如 "11" / "ubuntu 24.04" / "26"。与 platform 分开存：platform 是
  /// 固定分组维度，这里是随发行版无限增长的自由文本。null 表示无从得知。
  platformVersion   String?
  customData        Json?
  /// 该反馈是否已转成 GitHub Issue。提交者勾选转发时，Issue 建成功才落库，
  /// 所以这里为 false 的行一定是没要求转发的普通反馈。
  forwardedToGithub Boolean   @default(false)
  /// 生成的 Issue 编号与链接。GitHub 未返回编号时只留链接，二者互不依赖。
  githubIssueNumber Int?
  githubIssueUrl    String?
  /// Caller origin, captured at submit time. See the `Log` model.
  ip                String?
  userAgent         String?
  countryCode       String?
  countryName       String?
  regionName        String?
  city              String?
  /// Fingerprint for near-duplicate suppression; see `Log.dedupHash`.
  dedupHash         String?
  createdAt         Int       @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@index([projectKey, createdAt])
  @@index([dedupHash, createdAt])
}

model Log {
  id              String    @id @default(cuid())
  projectKey      String
  level           LogLevel
  content         String
  deviceInfo      Json?
  customData      Json?
  /// 隐藏后不在后台列表默认返回（需显式 include_hidden），但记录仍在，
  /// 等级统计也照常计入 —— 隐藏只影响展示，不影响数据。
  isHidden        Boolean   @default(false)
  /// Caller origin, captured at submit time. Stored as columns rather than
  /// inside `deviceInfo` because that field is client-supplied and therefore
  /// forgeable, while these are observed server-side — mixing the two would
  /// make it impossible to tell which is which when triaging.
  ip              String?
  userAgent       String?
  /// ISO-3166 alpha-2 / `LOCAL`; null when the address could not be placed.
  countryCode     String?
  countryName     String?
  /// Sub-national area (province/state), as reported by the geo provider.
  regionName      String?
  city            String?
  /// Inferred from the User-Agent; the log upload API has no platform field.
  platform        Platform?
  /// 同 `Feedback.platformVersion`；日志上报只能从 UA 解析。
  platformVersion String?
  /// Fingerprint of the payload plus caller, for near-duplicate suppression.
  /// A crashing client retries the same line every few seconds; keeping only
  /// the first within a short window preserves the signal without the flood.
  dedupHash       String?
  createdAt       Int       @default(dbgenerated("CAST(EXTRACT(EPOCH FROM now()) AS INTEGER)"))

  project Project @relation(fields: [projectKey], references: [projectKey], onDelete: Cascade)

  @@index([projectKey, createdAt])
  @@index([level, createdAt])
  @@index([dedupHash, createdAt])
}
